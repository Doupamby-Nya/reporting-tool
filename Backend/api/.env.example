# Copy to .env and set for this deployment. The real .env is not committed:
# it names the hosts allowed to call this API, which on an internal
# deployment means internal addresses.

# Origins allowed to call the API, comma-separated. The browser refuses a
# credentialed cross-origin request unless its own origin is listed here, so
# an empty or wrong value shows up as every request failing in the browser
# while curl keeps working.
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# Where the API keeps its runtime state — the fund registry, generated
# filings, saved drafts, the document store and the audit trail. Defaults to
# Backend/api/runtime. Point it outside the checkout in a real deployment.
# RUNTIME_DIR=/var/lib/regulatory-reporting

# The account database. SQLite in RUNTIME_DIR/platform.db by default; any
# SQLAlchemy URL works, e.g. postgresql+psycopg://user:password@host/dbname
# (install the driver first: poetry add "psycopg[binary]").
# DATABASE_URL=

# Session cookie. Set COOKIE_SECURE=true whenever the site is served over
# https - always, outside a developer's machine.
# COOKIE_SECURE=false
# SESSION_HOURS=12
